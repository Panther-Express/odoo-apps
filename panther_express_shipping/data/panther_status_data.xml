<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Panther status -> Odoo state mapping.
             * the webhook sends a status_id  -> matched on "Panther Status ID"
             * getCurrentStatus returns only name_en / name_ar (no id)
               -> matched on the English / Arabic name
             Adjust both to your Panther account:
             Panther Express > Configuration > Status Mapping -->

        <!-- Names really returned by https://panther-express.top (no status_id) -->
        <record id="panther_status_pickup_request" model="panther.status.mapping">
            <field name="sequence">5</field>
            <field name="name_en">Pickup Request</field>
            <field name="name_ar">طلب بيك أب</field>
            <field name="state">sent</field>
        </record>

        <record id="panther_status_1" model="panther.status.mapping">
            <field name="sequence">10</field>
            <field name="status_id">1</field>
            <field name="name_en">Shipment Created</field>
            <field name="name_ar">تم انشاء الشحنة</field>
            <field name="state">sent</field>
        </record>

        <record id="panther_status_2" model="panther.status.mapping">
            <field name="sequence">20</field>
            <field name="status_id">2</field>
            <field name="name_en">Picked Up</field>
            <field name="name_ar">تم الاستلام من التاجر</field>
            <field name="state">picked_up</field>
        </record>

        <record id="panther_status_3" model="panther.status.mapping">
            <field name="sequence">30</field>
            <field name="status_id">3</field>
            <field name="name_en">In Transit</field>
            <field name="name_ar">في الطريق</field>
            <field name="state">in_transit</field>
        </record>

        <record id="panther_status_4" model="panther.status.mapping">
            <field name="sequence">40</field>
            <field name="status_id">4</field>
            <field name="name_en">Out For Delivery</field>
            <field name="name_ar">خرجت للتسليم</field>
            <field name="state">out_for_delivery</field>
        </record>

        <record id="panther_status_5" model="panther.status.mapping">
            <field name="sequence">50</field>
            <field name="status_id">5</field>
            <field name="name_en">Delivered</field>
            <field name="name_ar">تم التسليم</field>
            <field name="state">delivered</field>
        </record>

        <record id="panther_status_6" model="panther.status.mapping">
            <field name="sequence">60</field>
            <field name="status_id">6</field>
            <field name="name_en">Returned</field>
            <field name="name_ar">مرتجع</field>
            <field name="state">returned</field>
        </record>

        <record id="panther_status_7" model="panther.status.mapping">
            <field name="sequence">70</field>
            <field name="status_id">7</field>
            <field name="name_en">Cancelled</field>
            <field name="name_ar">ملغاة</field>
            <field name="state">cancelled</field>
        </record>

    </data>
</odoo>
