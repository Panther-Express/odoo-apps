<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_panther_express" model="ir.module.category">
        <field name="name">Panther Express</field>
        <field name="description">Access rights for the Panther Express shipping integration.</field>
        <field name="sequence">80</field>
    </record>

    <record id="group_panther_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_panther_express"/>
        <field name="comment">Can create shipments and follow the tracking.</field>
    </record>

    <record id="group_panther_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_panther_express"/>
        <field name="implied_ids" eval="[(4, ref('group_panther_user'))]"/>
        <field name="comment">Can configure the API credentials and the status mapping.</field>
    </record>

    <!-- Salespeople and stock users get the Panther User rights -->
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('panther_express_shipping.group_panther_user'))]"/>
    </record>
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('panther_express_shipping.group_panther_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('panther_express_shipping.group_panther_manager'))]"/>
    </record>

    <!-- Multi company -->
    <record id="panther_shipment_company_rule" model="ir.rule">
        <field name="name">Panther Shipment: multi-company</field>
        <field name="model_id" ref="model_panther_shipment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
